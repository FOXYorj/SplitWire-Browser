{
  "manifest_version": 2,
  "name": "SplitWire Browser",
  "version": "1.4.0",
  "description": "SplitWire-Turkey tarayıcı sürümü — dosyasız tek tıkla bölünmüş tünelleme, otomatik bağlanma, reklam/oltalama kalkanı ve kişisel odak engelleyici.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_title": "SplitWire Browser",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "web_accessible_resources": [
    "blocked.html",
    "blocked.css",
    "blocked.js",
    "icons/foxy-avatar.png"
  ],
  "permissions": [
    "proxy",
    "storage",
    "privacy",
    "alarms",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "splitwire-browser@splitwire.local",
      "strict_min_version": "109.0"
    }
  }
}
