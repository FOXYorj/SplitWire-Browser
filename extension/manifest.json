{
  "manifest_version": 3,
  "name": "SplitWire Browser",
  "version": "1.4.0",
  "description": "SplitWire-Turkey tarayıcı sürümü — dosyasız tek tıkla bölünmüş tünelleme, otomatik bağlanma, reklam/oltalama kalkanı ve kişisel odak engelleyici.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "SplitWire Browser",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "proxy",
    "storage",
    "privacy",
    "alarms",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_ruleset",
        "enabled": true,
        "path": "rules/ads.json"
      },
      {
        "id": "trackers_ruleset",
        "enabled": true,
        "path": "rules/trackers.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.css",
        "blocked.js",
        "icons/foxy-avatar.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
